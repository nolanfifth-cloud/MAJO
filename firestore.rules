rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function userLocation() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.location;
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if signedIn() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    match /appConfig/{configId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /jobs/{jobId} {
      allow read: if isAdmin()
        || (signedIn()
          && 'targetWilayahList' in resource.data
          && resource.data.targetWilayahList.hasAny([userLocation()]));
      allow create, update, delete: if isAdmin();
    }

    match /jobProgress/{progressId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userUid == request.auth.uid
        && request.resource.data.userUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /completedReports/{reportId} {
      allow read: if isAdmin() || (signedIn() && resource.data.submittedBy == request.auth.uid);
      allow create: if signedIn() && request.resource.data.submittedBy == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.submittedBy == request.auth.uid);
    }
  }
}

